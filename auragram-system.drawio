<mxfile host="app.diagrams.net"><diagram id="auragram-system" name="Auragram Showcase Factory"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Auragram Showcase Factory: πώς δουλεύει το σύστημα&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Κάθε βράδυ οι agents φτιάχνουν ένα demo για έναν κλάδο. Το πρωί εσείς εγκρίνετε σε 3 σημεία και στέλνετε τα μηνύματα." style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1360" height="30" as="geometry"/></mxCell><mxCell id="infra" value="&lt;b&gt;ΥΠΟΔΟΜΗ&lt;/b&gt;" style="swimlane;html=1;startSize=30;rounded=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="290" height="590" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;Ουρά εργασιών&lt;/b&gt;&lt;br&gt;&lt;i&gt;Πίνακας κλάδος × υπηρεσία&lt;/i&gt;&lt;br&gt;&lt;br&gt;Κλάδοι: κομμωτήρια, ξενοδοχεία, ιατρεία, εστίαση, λογιστικά, κατασκευές&lt;br&gt;&lt;br&gt;Υπηρεσίες: Sales, Support, Operations, Analyst agent, Κρατήσεις" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="infra"><mxGeometry x="20" y="45" width="250" height="190" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;Ξεκινά κάθε βράδυ, παίρνει το επόμενο κελί του πίνακα και το περνά από τους agents. Όταν τελειώσει το όριο χρήσης, περιμένει." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="infra"><mxGeometry x="20" y="255" width="250" height="130" as="geometry"/></mxCell><mxCell id="workers" value="&lt;b&gt;Οι συνδρομές σας ως «workers»&lt;/b&gt;&lt;br&gt;Claude Code · Codex CLI (ChatGPT) · Gemini CLI&lt;br&gt;&lt;br&gt;Κάθε agent τρέχει σε ένα από αυτά, headless, σε δικό του git branch." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="infra"><mxGeometry x="20" y="405" width="250" height="165" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Κανόνες ασφαλείας&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Τα demo φαίνονται ως demo: χωρίς ψεύτικους πελάτες ή νούμερα&lt;br&gt;• Οι agents δουλεύουν μόνο σε branches, ποτέ σε main ή production&lt;br&gt;• Κανένα μήνυμα δεν φεύγει χωρίς εσάς&lt;br&gt;• Outreach μόνο σε επιχειρήσεις, με δημόσια στοιχεία και επιλογή διαγραφής" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="290" height="230" as="geometry"/></mxCell><mxCell id="scout" value="&lt;b&gt;1. SCOUT agent&lt;/b&gt;&lt;br&gt;Ψάχνει τι πονάει πραγματικά στον κλάδο (κριτικές, forums, ομάδες)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="270" height="80" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;ΕΣΕΙΣ&lt;/b&gt;&lt;br&gt;Αξίζει η ιδέα;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="445" y="220" width="200" height="100" as="geometry"/></mxCell><mxCell id="builder" value="&lt;b&gt;2. BUILDER agent&lt;/b&gt;&lt;br&gt;Φτιάχνει δουλεμένο demo&lt;br&gt;Next.js · Supabase · Vercel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="350" width="270" height="80" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;ΕΣΕΙΣ&lt;/b&gt;&lt;br&gt;Δουλεύει το demo;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="445" y="460" width="200" height="100" as="geometry"/></mxCell><mxCell id="content" value="&lt;b&gt;3. CONTENT agent&lt;/b&gt;&lt;br&gt;Σελίδα demo, script για Reel και για Loom" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="590" width="270" height="80" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;ΕΣΕΙΣ&lt;/b&gt;&lt;br&gt;Εντάξει για δημοσίευση;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="445" y="700" width="200" height="100" as="geometry"/></mxCell><mxCell id="outreach" value="&lt;b&gt;4. OUTREACH agent&lt;/b&gt;&lt;br&gt;Βρίσκει επιχειρήσεις του κλάδου και γράφει πρόχειρα μηνύματα" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="830" width="270" height="80" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;ΕΣΕΙΣ&lt;/b&gt;&lt;br&gt;Ελέγχετε και στέλνετε τα μηνύματα (ποτέ αυτόματα)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="410" y="940" width="270" height="70" as="geometry"/></mxCell><mxCell id="tracker" value="&lt;b&gt;5. TRACKER agent&lt;/b&gt;&lt;br&gt;Μετράει απαντήσεις, κλήσεις και τι αποδίδει" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="1050" width="270" height="80" as="geometry"/></mxCell><mxCell id="o_scout" value="&lt;b&gt;brief.md&lt;/b&gt;&lt;br&gt;Πρόβλημα, ποιος το έχει, πηγές, ιδέα για demo" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="300" height="80" as="geometry"/></mxCell><mxCell id="archive" value="Απορρίπτεται και πάει στο αρχείο ιδεών" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="760" y="240" width="300" height="60" as="geometry"/></mxCell><mxCell id="o_builder" value="&lt;b&gt;Live demo&lt;/b&gt; (Vercel preview)&lt;br&gt;+ κώδικας σε branch, με tests" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="300" height="80" as="geometry"/></mxCell><mxCell id="o_content" value="&lt;b&gt;Σελίδα «Demos» στο auragram-web&lt;/b&gt;&lt;br&gt;+ script για Reel και για Loom" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="300" height="80" as="geometry"/></mxCell><mxCell id="o_outreach" value="&lt;b&gt;Λίστα 10–20 επιχειρήσεων&lt;/b&gt;&lt;br&gt;+ προσωποποιημένα πρόχειρα email ή DM" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="830" width="300" height="80" as="geometry"/></mxCell><mxCell id="o_tracker" value="&lt;b&gt;Εβδομαδιαία αναφορά&lt;/b&gt;&lt;br&gt;Ποιοι κλάδοι και ποια demo φέρνουν κλήσεις" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="1050" width="300" height="80" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Υπόμνημα&lt;/b&gt;&lt;br&gt;&lt;font color='#6c8ebf'&gt;■&lt;/font&gt; Agent (δουλεύει μόνος του)&lt;br&gt;&lt;font color='#d79b00'&gt;■&lt;/font&gt; Εσείς (έγκριση, ~5 λεπτά το πρωί)&lt;br&gt;&lt;font color='#82b366'&gt;■&lt;/font&gt; Αποτέλεσμα (αρχείο ή link)&lt;br&gt;&lt;font color='#666666'&gt;■&lt;/font&gt; Υποδομή" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="290" height="120" as="geometry"/></mxCell><mxCell id="folders" value="&lt;b&gt;Φάκελοι στο MULTI-AGENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;queue/ ← ο πίνακας εργασιών&lt;br&gt;briefs/ ← ιδέες του scout&lt;br&gt;demos/ ← κώδικας των demo&lt;br&gt;content/ ← σελίδες, Reels, Loom&lt;br&gt;outreach/ ← πρόχειρα μηνύματα&lt;br&gt;reports/ ← αναφορές tracker&lt;br&gt;review/ ← &lt;b&gt;ό,τι περιμένει εσάς&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="260" width="290" height="210" as="geometry"/></mxCell><mxCell id="portfolio" value="&lt;b&gt;Portfolio&lt;/b&gt;&lt;br&gt;Ενότητα «Demos» στο site, που σήμερα είναι άδειο" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="560" width="290" height="70" as="geometry"/></mxCell><mxCell id="reels" value="&lt;b&gt;Περιεχόμενο για Reels&lt;/b&gt;&lt;br&gt;Για τα προσωπικά προφίλ Χρήστου και Παναγιώτη" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="290" height="70" as="geometry"/></mxCell><mxCell id="leads" value="&lt;b&gt;Πελάτες&lt;/b&gt;&lt;br&gt;Κλήση «Χάρτης AI» → Pilot 2–4 εβδομάδων → έργο" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="930" width="290" height="90" as="geometry"/></mxCell><mxCell id="e_q_o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#666666;" edge="1" parent="1" source="queue" target="orch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_w_o" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="workers" target="orch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o_s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="orch" target="scout"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="430"/><mxPoint x="355" y="150"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="scout" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="g1" target="builder"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="builder" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="g2" target="content"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="content" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Ναι" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="g3" target="outreach"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="outreach" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="g4" target="tracker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="Όχι" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="g1" target="archive"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n2" value="Όχι: σχόλια" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#d79b00;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g2" target="builder"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="510"/><mxPoint x="375" y="390"/></Array></mxGeometry></mxCell><mxCell id="n3" value="Όχι: αλλαγές" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#d79b00;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g3" target="content"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="750"/><mxPoint x="375" y="630"/></Array></mxGeometry></mxCell><mxCell id="out_scout" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="scout" target="o_scout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out_builder" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="builder" target="o_builder"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out_content" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="content" target="o_content"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out_outreach" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="outreach" target="o_outreach"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out_tracker" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="tracker" target="o_tracker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="o_content" target="portfolio"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;exitX=1;exitY=0.75;" edge="1" parent="1" source="o_content" target="reels"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gl" value="απαντήσεις" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1" source="g4" target="leads"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;strokeColor=#6c8ebf;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontColor=#6c8ebf;" edge="1" parent="1" source="tracker" target="infra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="1090"/><mxPoint x="20" y="405"/></Array></mxGeometry></mxCell><mxCell id="loopnote" value="&lt;i&gt;Βρόχος μάθησης: ο tracker βλέπει ποιοι κλάδοι φέρνουν κλήσεις και τους βάζει πρώτους στην ουρά&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="290" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
